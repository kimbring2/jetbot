    "from nanoowl.owl_predictor import (OwlPredictor)\n",
    "from nanoowl.owl_drawing import (draw_owl_output)\n",
    "\n",
    "model = \"google/owlvit-base-patch32\"\n",
    "image_encoder_engine = \"/home/kimbring2/nanoowl/data/owl_image_encoder_patch32.engine\"\n",
    "predictor = OwlPredictor(model, image_encoder_engine=image_encoder_engine)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Now, let's execute our network using some camera input.  By default the ``ObjectDetector`` class expects ``bgr8`` format that the camera produces.  However,\n",
    "you could override the default pre-processing function if your input is in a different format."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['a stop sign', ' a can']\n"
     ]
    },
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "/home/kimbring2/nanoowl/nanoowl/image_preprocessor.py:71: UserWarning: The given NumPy array is not writable, and PyTorch does not support non-writable tensors. This means writing to this tensor will result in undefined behavior. You may want to copy the array to protect its data or make it writable before converting it to a tensor. This type of warning will be suppressed for the rest of this program. (Triggered internally at /opt/pytorch/pytorch/torch/csrc/utils/tensor_numpy.cpp:206.)\n",
      "  image = torch.from_numpy(np.asarray(image))\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[03/22/2026-16:37:05] [TRT] [W] Using default stream in enqueueV3() may lead to performance issues due to additional calls to cudaStreamSynchronize() by TensorRT to ensure correct synchronization. Please use non-default stream instead.\n",
      "detections:  OwlDecodeOutput(labels=tensor([1], device='cuda:0'), scores=tensor([0.1783], device='cuda:0', grad_fn=<IndexBackward0>), boxes=tensor([[ 74.2676,  39.2578, 100.9277, 116.7480]], device='cuda:0'), input_indices=tensor([0], device='cuda:0'))\n"
     ]
    }
   ],
   "source": [
    "from PIL import Image\n",
    "import numpy as np\n",
    "import cv2\n",
    "\n",
    "prompt = \"[a stop sign, a can]\"\n",
    "threshold = 0.1\n",
    "num_profiling_runs = 30\n",
    "\n",
    "prompt = prompt.strip(\"][()\")\n",
    "text = prompt.split(',')\n",
    "print(text)\n",
    "\n",
    "#print(\"camera.value.shape: \", camera.value.shape)\n",
    "\n",
    "image_3_channel = camera.value[:, :, :3]\n",
    "flipped_image = cv2.flip(image_3_channel, -1)\n",
    "\n",
    "image = Image.fromarray(np.uint8(flipped_image))\n",
    "#print(\"image.shape: \", image.shape)\n",
    "\n",
    "text_encodings = predictor.encode_text(text)\n",
    "detections = predictor.predict(image=image, text=text, text_encodings=text_encodings, threshold=threshold, pad_square=False)\n",
    "print(\"detections: \", detections)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
